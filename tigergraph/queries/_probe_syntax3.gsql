USE GRAPH hhg_fraud_graph

/* Reverse-traversal spelling generalisation: -(<-EDGE)- */
CREATE QUERY p3c_q1() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R = SELECT c FROM S:t -(<-INVOLVES)- ClosedCase:c;
  PRINT R;
}

CREATE QUERY p3c_q2() FOR GRAPH hhg_fraud_graph {
  C0 = {Card.*};
  R = SELECT cc FROM C0:c -(<-ON_CARD)- ClosedCase:cc;
  PRINT R;
}

CREATE QUERY p3c_q3() FOR GRAPH hhg_fraud_graph {
  D0 = {DeviceProfile.*};
  R = SELECT t FROM D0:d -(<-FROM_DEVICE)- Transaction:t;
  PRINT R;
}

/* Chained multi-hop: which spelling, if any, is legal? */
/* q4 = reverse then forward */
CREATE QUERY p3c_q4() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R = SELECT t2 FROM S:t -(<-MADE)- Card:c -(MADE)- Transaction:t2;
  PRINT R;
}

/* q5 = two forward hops, no alias on the intermediate vertex */
CREATE QUERY p3c_q5() FOR GRAPH hhg_fraud_graph {
  C0 = {Card.*};
  R = SELECT t2 FROM C0:c -(MADE)- Transaction -(NEXT)- Transaction:t2;
  PRINT R;
}

/* q6 = two forward hops with edge aliases */
CREATE QUERY p3c_q6() FOR GRAPH hhg_fraud_graph {
  C0 = {Card.*};
  R = SELECT t2 FROM C0:c -(MADE:e1)- Transaction:t -(NEXT:e2)- Transaction:t2;
  PRINT R;
}

/* q7 = same chain expressed as two single-hop statements (control) */
CREATE QUERY p3c_q7() FOR GRAPH hhg_fraud_graph {
  C0 = {Card.*};
  Tmp = SELECT t FROM C0:c -(MADE)- Transaction:t;
  R = SELECT t2 FROM Tmp:t -(NEXT)- Transaction:t2;
  PRINT R;
}
