# GSQL Loading Jobs - Edges
# Run after vertices are loaded. No invented relationships; all from verified Phase 0 edges.
USE GRAPH hhg_fraud_graph

CREATE LOADING JOB load_owns FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/owns.csv";
  LOAD f TO EDGE OWNS VALUES ($"from_customer_id", $"to_card_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_made FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/made.csv";
  LOAD f TO EDGE MADE VALUES ($"from_card_id", $"to_txn_id", $"sequence_num") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_next FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/next.csv";
  LOAD f TO EDGE NEXT VALUES ($"from_txn_id", $"to_txn_id", $"time_delta_hours", $"amount_ratio", $"channel_change") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_billed_in FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/billed_in.csv";
  LOAD f TO EDGE BILLED_IN VALUES ($"from_txn_id", $"to_region_code", $"is_home_country", $"channel") USING header="true", separator=",", QUOTE="double";
}

