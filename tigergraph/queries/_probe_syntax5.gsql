USE GRAPH hhg_fraud_graph

/* f1: explicit forward marker -> */
CREATE QUERY p3e_f1() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R = SELECT d FROM S:t -(->FROM_DEVICE)- DeviceProfile:d;
  PRINT R;
}

/* f2: reverse hop then explicit-forward hop (are the two markers compatible?) */
CREATE QUERY p3e_f2() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R1 = SELECT c FROM S:t -(<-MADE)- Card:c;
  R2 = SELECT d FROM S:t -(->FROM_DEVICE)- DeviceProfile:d;
  PRINT R1;
  PRINT R2;
}

/* f3: reverse hop then implicit-forward hop (the failing combination) */
CREATE QUERY p3e_f3() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R1 = SELECT c FROM S:t -(<-MADE)- Card:c;
  R2 = SELECT d FROM S:t -(FROM_DEVICE)- DeviceProfile:d;
  PRINT R1;
  PRINT R2;
}

/* f4: implicit-forward hop then reverse hop */
CREATE QUERY p3e_f4() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R1 = SELECT d FROM S:t -(FROM_DEVICE)- DeviceProfile:d;
  R2 = SELECT c FROM S:t -(<-MADE)- Card:c;
  PRINT R1;
  PRINT R2;
}

/* f5: only reverse hops, several statements (control) */
CREATE QUERY p3e_f5() FOR GRAPH hhg_fraud_graph {
  S = {Transaction.*};
  R1 = SELECT c FROM S:t -(<-MADE)- Card:c;
  R2 = SELECT cc FROM R1:c -(<-ON_CARD)- ClosedCase:cc;
  PRINT R1;
  PRINT R2;
}

/* f6: chained hops written with explicit forward markers */
CREATE QUERY p3e_f6() FOR GRAPH hhg_fraud_graph {
  C0 = {Card.*};
  R = SELECT t2 FROM C0:c -(->MADE)- Transaction:t -(->NEXT)- Transaction:t2;
  PRINT R;
}
