# TigerGraph connection — fill from your Savanna / Community instance
# Never commit real credentials. Copy this file to .env and set values.
TIGERGRAPH_HOST=
TIGERGRAPH_PORT=14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=
TIGERGRAPH_GRAPH_NAME=hhg_fraud_graph
TIGERGRAPH_TOKEN=

# Optional: data paths (defaults to repo-relative)
DATA_DIR=./data
VERTICES_DIR=./data/vertices
EDGES_DIR=./data/edges

# ---------------------------------------------------------------------------
# LLM — Google AI Studio (Gemma). Copy this file to .env and paste your key.
#   1. https://aistudio.google.com/apikey  -> create a key (starts with "AIza"
#      or a newer "AQ." prefixed key).
#   2. Put it on the LLM_API_KEY= line below, with no quotes and no spaces.
#   3. .env is gitignored — this template stays empty and is safe to commit.
# ---------------------------------------------------------------------------
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Quick self-test once the key is in .env (prints status, never the key):
#   python agent/llm/client.py
