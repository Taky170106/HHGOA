}

CREATE LOADING JOB load_from_device FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/from_device.csv";
  LOAD f TO EDGE FROM_DEVICE VALUES ($"from_txn_id", $"to_device_profile_id", $"newness", $"proxy_type", $"match_status", $"device_type") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_involves FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/involves.csv";
  LOAD f TO EDGE INVOLVES VALUES ($"from_case_id", $"to_txn_id", $"is_first_fraud", $"sequence_in_case") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_on_card FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/on_card.csv";
  LOAD f TO EDGE ON_CARD VALUES ($"from_case_id", $"to_card_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_connected_to FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/connected_to.csv";
  LOAD f TO EDGE CONNECTED_TO VALUES ($"from_case_id", $"to_card_id", $"connection_type") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_triggers FOR GRAPH hhg_fraud_graph {
  DEFINE FILENAME f = "data/edges/triggers.csv";
  LOAD f TO EDGE TRIGGERS VALUES ($"from_case_id", $"to_txn_id", $"trigger_type", $"risk_score") USING header="true", separator=",", QUOTE="double";
}

# Run: for each job -> RUN LOADING JOB <name> USING f="..."
# Recommended order: owns, made, next, billed_in, purchaser/recipient, from_device, involves, on_card, connected_to, triggers
