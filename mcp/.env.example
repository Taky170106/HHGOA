# =============================================================================
# HHGoa 2026 — MCP / TigerGraph Environment Template
# Copy to .env (gitignored) and fill real values. Never commit .env.
# Reference: Official TigerGraph MCP (tigergraph-mcp 0.1.0+) env vars
# Repo: https://github.com/tigergraph/tigergraph-mcp
# This layer: mcp/tools/* is a READ-ONLY controlled investigation wrapper
#            on top of the official MCP — no writes, no schema mutation.
# =============================================================================

# --- TigerGraph connection (official MCP compatible) ---
# Host without scheme or with scheme; e.g. my-instance.i.tgcloud.io or https://host
TG_HOST=
TG_GRAPHNAME=hhg_fraud_graph
TG_USERNAME=
TG_PASSWORD=
TG_API_TOKEN=
TG_JWT_TOKEN=
# Alternative legacy names respected by our file-fallback helpers:
# TIGERGRAPH_HOST, TIGERGRAPH_USERNAME, TIGERGRAPH_PASSWORD, TIGERGRAPH_TOKEN

# --- Ports (official MCP) ---
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
TG_SSL_PORT=

# --- Cloud / auth ---
# Set to true if using TigerGraph Cloud (affects token handling)
TG_TGCLOUD=false
TG_SECRET=
TG_CERT_PATH=

# --- MCP runtime ---
# stdio (default) or streamable-http; official MCP supports both
MCP_ENDPOINT=
# Example for streamable-http: http://localhost:8000/mcp

# --- Logging ---
TG_LOG_TOOL_CALLS=true
TG_LOG_CALLER_IDENTITY=true

# --- Optional: tool filtering (mirrors official --allowed-tools / --blocked-tools) ---
# Comma-separated tool names. Our layer enforces mcp/config/tool_policy.yaml allowlist;
# these envs additionally restrict what the OFFICIAL MCP exposes when run standalone.
TG_DEFAULT_PROFILE=
TG_ALLOWED_TOOLS=get_transaction,get_customer_history,get_card_history,find_device_connections,find_related_transactions,find_related_cases,temporal_chain,calculate_exposure,benchmark_case_context
TG_BLOCKED_TOOLS=create_vertex,update_vertex,delete_vertex,create_edge,update_edge,delete_edge,run_gsql,install_query,create_schema

# --- Project local ---
HHG_ROOT=D:\HHG
DATA_DIR=D:\HHG\data
# VERTICES_DIR and EDGES_DIR default to $DATA_DIR/vertices and $DATA_DIR/edges

# --- LLM / GraphRAG (Phase 3+, not required for Phase 2 MCP) ---
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_MODEL=
# DATABASE_URL=

# NOTE: Real .env is gitignored. Do NOT commit credentials.
# File-fallback (no TG_HOST) uses data/vertices/*.csv + data/edges/*.csv and marks source.kind=file_fallback.
